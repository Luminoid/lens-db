{
  "name": "lens-db",
  "version": "0.0.0",
  "private": true,
  "description": "LensDB: interactive camera-lens comparison chart for modern mirrorless systems (lens.luminoid.dev). SvelteKit 5 + ECharts over a versioned JSON lens database.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "validate": "node scripts/validate.mjs",
    "meta": "node scripts/build-meta.mjs",
    "meta:price": "node scripts/build-meta.mjs --price-check"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "echarts": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
