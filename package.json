{
  "name": "lens-db",
  "version": "1.0.0",
  "private": true,
  "description": "LensDB: interactive camera-lens comparison chart for modern mirrorless systems (lens.luminoid.dev). SvelteKit 5 + ECharts over a versioned JSON lens database.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Luminoid",
  "homepage": "https://lens.luminoid.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luminoid/lens-db.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "validate": "node scripts/validate.mjs",
    "meta": "node scripts/build-meta.mjs",
    "meta:price": "node scripts/build-meta.mjs --price-check"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#data/*": "./data/*"
  }
}
