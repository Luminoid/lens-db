# Cloudflare Pages security + caching headers. Copied verbatim to the build root by adapter-static.
# The Content-Security-Policy that governs scripts/styles is delivered as a <meta> tag by SvelteKit
# (hash mode; see svelte.config.js). frame-ancestors can only be enforced via an HTTP header, so it
# lives here alongside X-Frame-Options for older browsers. HSTS carries no `preload` token: the
# preload list only accepts registrable apex domains, so it would be inert on this subdomain.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=(), display-capture=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted build assets never change content; cache them hard. Pages combines the headers of
# every matching rule, so the always-revalidate Cache-Control from /* is detached (the ! line) before
# the hashed /_app/immutable/* bundle gets its own.
/_app/immutable/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unversioned static assets change rarely; a day of browser cache skips a revalidation round trip
# per visit without risking a long-stale icon after a redesign.
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
